@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div>
        <div class="bg-white rounded-lg p-4 shadow-sm">
            <img src="https://via.placeholder.com/800x800?text=Product+Image" alt="Product image" class="w-full h-auto object-cover rounded-md" />
        </div>
        <div class="mt-4 grid grid-cols-4 gap-3">
            <img src="https://via.placeholder.com/200x200?text=Thumb+1" alt="thumb" class="w-full h-24 object-cover rounded-md" />
            <img src="https://via.placeholder.com/200x200?text=Thumb+2" alt="thumb" class="w-full h-24 object-cover rounded-md" />
            <img src="https://via.placeholder.com/200x200?text=Thumb+3" alt="thumb" class="w-full h-24 object-cover rounded-md" />
            <img src="https://via.placeholder.com/200x200?text=Thumb+4" alt="thumb" class="w-full h-24 object-cover rounded-md" />
        </div>
    </div>

    <div>
        <div class="bg-white rounded-lg p-6 shadow-sm">
            <h1 class="text-2xl font-bold mb-2">Tên sản phẩm mẫu</h1>
            <div class="text-sm text-gray-500 mb-4">Mã SP: TS-0001</div>
            <div class="flex items-center gap-4 mb-4">
                <div class="text-2xl font-extrabold">₫2,490,000</div>
                <div class="text-sm text-gray-500 line-through">₫2,990,000</div>
            </div>

            <p class="text-gray-700 mb-6">Mô tả dài hơn một chút để người dùng nắm được điểm mạnh, tính năng, và thông số kỹ thuật cơ bản của sản phẩm.</p>

            <div class="flex items-center gap-4 mb-6">
                <label class="text-sm text-gray-600">Số lượng</label>
                <input type="number" value="1" min="1" class="w-20 border border-gray-200 rounded-md px-2 py-1" />
                <button class="bg-orange-500 text-white px-4 py-2 rounded-md font-medium">Thêm vào giỏ</button>
            </div>

            <div class="text-sm text-gray-600">Giao hàng: trong 2-3 ngày</div>
        </div>
    </div>
</div>
