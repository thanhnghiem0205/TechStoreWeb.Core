<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Content/styleLogSign.css")" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <title>@ViewBag.Title – TechStoreVN</title>
    <style>
        /* Critical auth layout – luôn load kể cả khi file CSS ngoài lỗi */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body.auth-body { height: 100%; }
        body.auth-body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            overflow-x: hidden;
        }
        .auth-page {
            display: flex;
            flex-direction: row;
            min-height: 100vh;
            width: 100%;
        }
        .auth-brand {
            flex: 1 1 45%;
            min-width: 0;
            display: flex;
            align-items: center;
            padding: 64px 72px;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            position: relative;
            overflow: hidden;
        }
        .auth-brand::before {
            content: '';
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(102,126,234,.2) 0%, transparent 50%),
                        radial-gradient(circle at 80% 50%, rgba(0,212,255,.15) 0%, transparent 50%);
            pointer-events: none;
        }
        .auth-orb {
            position: absolute; border-radius: 50%; filter: blur(100px);
            animation: orbFloat 20s ease-in-out infinite alternate;
        }
        .auth-orb-1 { width: 400px; height: 400px; background: rgba(102,126,234,.5); top: -100px; left: -80px; }
        .auth-orb-2 { width: 350px; height: 350px; background: rgba(0,212,255,.4); bottom: -80px; right: -60px; animation-delay: -5s; }
        .auth-orb-3 { width: 250px; height: 250px; background: rgba(236,72,153,.3); top: 50%; left: 50%; animation-delay: -10s; }
        @@keyframes orbFloat { from { transform: translate(0,0); } to { transform: translate(40px,-50px); } }

        .auth-form-panel {
            flex: 1 1 55%;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 32px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            overflow-y: auto;
        }
        .auth-card {
            background: #fff;
            border-radius: 32px;
            box-shadow: 0 24px 80px rgba(0,0,0,.12);
            width: 100%;
            max-width: 500px;
            padding: 48px 44px;
            border: 2px solid rgba(0,0,0,.06);
            transition: all .4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .auth-card:hover { box-shadow: 0 32px 100px rgba(102,126,234,.15); }
        .auth-card.register-card { max-width: 560px; }
        @@media (max-width: 900px) {
            .auth-page { flex-direction: column; }
            .auth-brand { flex: none; padding: 48px 36px; min-height: auto; }
            .auth-form-panel { flex: 1; padding: 32px 20px 48px; }
            .auth-card { padding: 36px 32px; }
        }
        @@media (max-width: 600px) {
            .auth-brand { padding: 36px 24px; }
            .auth-card { padding: 32px 24px; border-radius: 24px; }
        }
    </style>
</head>
<body class="auth-body">
    @RenderBody()
</body>
</html>
