@* New clean Tailwind-based layout (prototype). Uses Tailwind CDN for quick scaffold. *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - TechStore</title>

    <!-- Inter font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CDN for prototype -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Alpine.js for light interactions -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link rel="stylesheet" href="/wwwroot/css/theme.css" />

    @RenderSection("Head", required: false)
</head>
<body class="antialiased bg-gray-50 text-gray-800" style="font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;">
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center space-x-4">
                    <a href="/" class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-teal-500 rounded-md flex items-center justify-center text-white font-bold">TS</div>
                        <div>
                            <div class="text-lg font-semibold">TechStore</div>
                            <div class="text-xs text-gray-500">Electronics & Accessories</div>
                        </div>
                    </a>
                </div>

                <div class="flex-1 px-6">
                    <form method="get" action="/Search" class="relative">
                        <input name="q" type="search" placeholder="Tìm sản phẩm, thương hiệu, mã..." class="w-full rounded-full border border-gray-200 shadow-sm py-3 px-4 focus:outline-none focus:ring-2 focus:ring-teal-300" />
                        <button type="submit" class="absolute right-1 top-1/2 -translate-y-1/2 bg-teal-500 text-white px-4 py-2 rounded-full text-sm">Tìm</button>
                    </form>
                </div>

                <div class="flex items-center space-x-4">
                    <a href="/Account" class="text-sm text-gray-700 hover:text-teal-600">Tài khoản</a>
                    <a href="/Cart" class="relative inline-flex items-center px-3 py-2 bg-gray-100 rounded-full hover:bg-gray-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" viewBox="0 0 20 20" fill="currentColor"><path d="M16 11V9a4 4 0 00-4-4H6V4a1 1 0 10-2 0v1H2a1 1 0 000 2h1l1.2 6.013A2 2 0 006.14 15h7.72a2 2 0 001.94-1.987L17 11h-1z"/></svg>
                        <span class="ml-2 text-sm">Giỏ hàng</span>
                        <span class="ml-2 inline-flex items-center justify-center w-6 h-6 bg-teal-500 text-white text-xs font-medium rounded-full">0</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-white border-t mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <div class="text-lg font-semibold">TechStore</div>
                <p class="text-sm text-gray-500 mt-2">Cửa hàng thiết bị công nghệ — giao hàng toàn quốc.</p>
            </div>
            <div>
                <div class="font-medium text-sm mb-2">Hỗ trợ</div>
                <ul class="space-y-1 text-sm text-gray-600">
                    <li><a href="#">Chính sách vận chuyển</a></li>
                    <li><a href="#">Chính sách đổi trả</a></li>
                    <li><a href="#">Liên hệ</a></li>
                </ul>
            </div>
            <div>
                <div class="font-medium text-sm mb-2">Đăng ký nhận tin</div>
                <form class="flex gap-2" onsubmit="event.preventDefault(); alert('Cảm ơn!');">
                    <input type="email" placeholder="Email của bạn" class="flex-1 rounded-md border border-gray-200 px-3 py-2" />
                    <button class="bg-teal-500 text-white px-4 py-2 rounded-md">Đăng ký</button>
                </form>
            </div>
        </div>
        <div class="bg-gray-50 border-t">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">© @DateTime.Now.Year TechStore. All rights reserved.</div>
        </div>
    </footer>

    <script src="/wwwroot/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
