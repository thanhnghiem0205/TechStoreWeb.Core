@{
    ViewBag.Title = "Trang chủ";
}

<section class="mt-6">
    <div class="bg-gradient-to-r from-white via-gray-50 to-gray-50 rounded-lg overflow-hidden shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div class="p-8">
                <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Sản phẩm công nghệ chất lượng</h1>
                <p class="text-gray-600 mb-6">Tập hợp những thiết bị phổ biến, bảo hành chính hãng và giao hàng nhanh chóng.</p>
                <a href="#products" class="inline-flex items-center gap-3 bg-teal-500 text-white px-5 py-3 rounded-md font-medium hover:bg-teal-600">Xem sản phẩm</a>
            </div>
            <div class="p-8">
                <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=1200&q=80&auto=format&fit=crop" alt="Hero" class="w-full rounded-md shadow-md" />
            </div>
        </div>
    </div>
</section>

<section id="products" class="mt-10">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Sản phẩm nổi bật</h2>
        <a href="/Products" class="text-sm text-teal-600">Xem tất cả</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @for (int i = 1; i <= 8; i++) {
            <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                <a href="/Products/Detail?id=@i">
                    <img class="w-full h-56 object-cover" src="https://via.placeholder.com/600x600?text=Product+@i" alt="Product @i" loading="lazy" />
                </a>
                <div class="p-4">
                    <a href="/Products/Detail?id=@i" class="block font-medium text-gray-900">Thiết bị @i</a>
                    <div class="mt-2 text-sm text-gray-500">Mô tả ngắn gọn sản phẩm để người dùng hiểu nhanh.</div>
                    <div class="mt-4 flex items-center justify-between">
                        <div class="text-lg font-semibold">₫1,990,000</div>
                        <button class="bg-teal-500 text-white px-3 py-1 rounded-md text-sm">Thêm</button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
